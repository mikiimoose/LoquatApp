<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imageViewWifiSignal"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_wifi"
        android:contentDescription="Wi-Fi Signal Strength" />

    <TextView
        android:id="@+id/textViewNetworkName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:textSize="16sp"
        tools:text="My Awesome Network"/>

    <ImageView
        android:id="@+id/imageViewSecurityType"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_lock"
        android:contentDescription="Network Security Type" />
</LinearLayout>